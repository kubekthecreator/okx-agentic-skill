# Auth is handled by the `onchainos` CLI — log in once with:
#   onchainos wallet login <email>          # email + OTP flow
#   onchainos wallet login --force          # API Key flow (env: OKX_API_KEY/SECRET/PASSPHRASE)
# Verify with: `onchainos wallet status`.
# See: https://web3.okx.com/onchainos/dev-portal

# Optional CLI override (defaults to "onchainos" on PATH)
# ONCHAINOS_CLI=onchainos

# Chain (default solana). Bot is whitelist-only on SPL tokens.
# OKX_CHAIN=solana

# Telegram alerts (optional but recommended)
# Create bot: @BotFather on Telegram, get token
# Get chat_id: send a message to your bot, then visit https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bot behavior
DRY_RUN=true                    # set to false for live trading
LOG_LEVEL=info                  # debug | info | warn | error
TICK_INTERVAL_MS=60000          # main loop frequency (60s default)

# Capital limits
MAX_PORTFOLIO_USD=200           # bot will never deploy more than this
MIN_TRADE_SIZE_USD=5            # don't bother with smaller trades
